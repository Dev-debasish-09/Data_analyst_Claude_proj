# Copy to .env (gitignored) in the project root and fill in. Never commit real values.

# dev | staging | prod  (default: dev)
RETAIL_PULSE_ENV=dev

# Data source. dev defaults to a local synthetic SQLite file.
RETAIL_PULSE_DB_URL=sqlite:///./local_dev.db

# Report engine: auto | claude | huggingface
#   auto = Claude if ANTHROPIC_API_KEY is set, otherwise (in dev) a free local Hugging Face model.
RETAIL_PULSE_NARRATIVE_PROVIDER=auto

# Claude API (optional in dev; required in staging/prod unless the provider is huggingface)
ANTHROPIC_API_KEY=
RETAIL_PULSE_MODEL=claude-sonnet-5

# Local Hugging Face model (needs: pip install -e ".[hf]"; downloaded once, about 3 GB, runs on CPU)
# A larger model writes better reports but is slower and needs more memory.
RETAIL_PULSE_HF_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# Logging
RETAIL_PULSE_LOG_LEVEL=DEBUG
