# Copy to .env (gitignored) in the project root and fill in. Never commit real values.

# dev | staging | prod  (default: dev)
RETAIL_PULSE_ENV=dev

# Data source. dev defaults to a local synthetic SQLite file.
RETAIL_PULSE_DB_URL=sqlite:///./local_dev.db

# Claude API (required in staging/prod; optional in dev until the narrative layer is built)
ANTHROPIC_API_KEY=
RETAIL_PULSE_MODEL=claude-sonnet-5

# Logging
RETAIL_PULSE_LOG_LEVEL=DEBUG
